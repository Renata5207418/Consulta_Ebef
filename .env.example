# Configurações do Banco de Dados (Domínio Sistemas)
# O DOMINIO_HOST pode ser um IP (ex: 192.168.1.100), 'localhost' ou um endereço de rede (ex: endereco.banco)
DOMINIO_HOST=192.168.0.10
DOMINIO_PORT=1111
DOMINIO_DB=nome_do_banco_de_dados
DOMINIO_USER=seu_usuario_odbc
DOMINIO_PASSWORD=sua_senha_odbc
DOMINIO_ENGINE=dominio

# Configurações da Regra de Negócio e-BEF
EBEF_CODIGO_MAXIMO=9999
FLASK_DEBUG=true

# Configurações da busca na ReceitaWS
RECEITAWS_TTL_DIAS=30
RECEITAWS_MAX_POR_EXECUCAO=40
RECEITAWS_INTERVALO_SEGUNDOS=23
RECEITAWS_ESPERAS_429_SEGUNDOS=90,180,300,600

NOME_ESCRITORIO=Seu escritório

# Comunicação e-BEF / SMTP
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=email@seudominio.com.br
SMTP_PASSWORD=Sua_senha
SMTP_TIMEOUT=30

EBEF_EMAIL_ASSUNTO=Solicitação de informações | e-BEF

# MODO DE TESTE
EBEF_EMAIL_DESTINO_TESTE=emailteste@seudominio.com.br